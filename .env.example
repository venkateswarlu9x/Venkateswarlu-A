# Environment Variables for Employee Management System

# Server Port
PORT=3000

# MySQL Database Configuration (For local setup / XAMPP / MySQL Workbench)
# If MySQL is not running or credentials are not supplied, the backend seamlessly runs with its embedded persistent data store.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_management_db
DB_PORT=3306

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
